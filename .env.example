# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin / Service Role (HANYA untuk skrip server / seed, JANGAN bocor ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password default bersama untuk inisialisasi akun 24 mahasiswa
# Disimpan di .env.local, akun dibuat nonaktif (is_active = false)
DEFAULT_STUDENT_PASSWORD=GantiDenganPasswordRahasiaAwal2025!
 